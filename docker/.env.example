# =============================================================================
# CASAtlas — Docker environment
# Copy to .env (same directory) and edit before `docker compose up -d`:
#   cp .env.example .env
#
# NOTE: Inside the compose network the database host is `db`, not `localhost`.
# =============================================================================

# Database (managed by the db service in this compose file)
# Point this at your own PostgreSQL instead to use an external DB.
DATABASE_URL=postgresql://casatlas:casatlas@db:5432/casatlas

# Auth — MUST be set to a random 32-byte value. Generate with:
#   openssl rand -base64 32
AUTH_SECRET=replace-with-openssl-rand-base64-32

# OAuth (leave empty to disable the provider)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional: override the canonical Auth.js URL if it differs from NEXT_PUBLIC_APP_URL
# (defaults to NEXT_PUBLIC_APP_URL). AUTH_URL is the Auth.js v5 name.
# AUTH_URL=http://localhost:3000

# Default for new-account registration. Admins can toggle this at runtime in
# the admin Settings page — the DB value takes precedence over this env var.
ALLOW_REGISTRATION=true

# Dev-only email login (sign in as any seeded/existing user by email). Do NOT enable in production.
AUTH_DEV_LOGIN=false

# Required when behind a proxy or non-localhost hostname (Docker).
AUTH_TRUST_HOST=true

# Upload directory (inside the container — the uploads_data volume mounts here)
UPLOAD_DIR=/app/uploads
