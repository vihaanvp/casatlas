# Database
DATABASE_URL=postgresql://casatlas:casatlas@localhost:5432/casatlas

# Auth
AUTH_SECRET=generate-with-openssl-rand-base64-32
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000

# Default for new-account registration. Admins can toggle this at runtime in
# the admin Settings page — the DB value takes precedence over this env var.
ALLOW_REGISTRATION=true

# Dev-only email login (sign in as any seeded/existing user by email). Do NOT enable in production.
AUTH_DEV_LOGIN=false

# Set true only when deploying behind a proxy or on a non-localhost hostname.
# Auth.js v5 rejects untrusted hosts in production (next start / Docker).
AUTH_TRUST_HOST=false

# Upload
UPLOAD_DIR=./uploads

# Wiki publish script (optional) — git remote for the GitHub wiki repo.
# Defaults to https://github.com/<owner>/<repo>.wiki.git when unset.
WIKI_REPO=